+    /// Alpha patch: marks the point in paint order where the macOS edge blur splits the frame.
+    /// Everything painted before this call (and under it) is blurred in the edge bands;
+    /// everything painted after is drawn sharp on top. Call from the root of the element tree.
+    /// Has no effect unless `set_edge_blur` is active.
+    pub fn paint_edge_blur_split(&mut self) {
+        let bounds = Bounds { origin: point(px(0.), px(0.)), size: self.viewport_size() };
+        let mut quad = crate::fill(bounds, crate::transparent_black());
+        quad.border_color = Hsla { h: crate::scene::EDGE_BLUR_MARKER_HUE, s: 0., l: 0., a: 0. };
+        self.paint_quad(quad);
+    }
