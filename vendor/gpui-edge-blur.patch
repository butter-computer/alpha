+// ---------------------------------------------------------------------------
+// alpha patch: progressive edge blur (see vendor/README.md).
+// ---------------------------------------------------------------------------
+struct EdgeBlurParams {
+  float2 viewport;      // framebuffer size in pixels
+  float top_px;         // height of the top band in pixels (0 = off)
+  float bottom_px;      // height of the bottom band in pixels (0 = off)
+  float max_radius_px;  // blur radius at the window edge
+  float tint_max;       // tint opacity at the window edge
+  float bottom_solid_px; // bottom rows that are always fully blurred/tinted (strength 1)
+  float pad;
+  float4 tint;          // tint colour (same colour space as the framebuffer)
+};
+
+struct EdgeBlurVertexOut {
+  float4 position [[position]];
+};
+
+vertex EdgeBlurVertexOut edge_blur_vertex(uint vid [[vertex_id]]) {
+  // Single oversized triangle covering the viewport.
+  float2 p = float2((vid << 1) & 2, vid & 2);
+  EdgeBlurVertexOut out;
+  out.position = float4(p * 2.0 - 1.0, 0.0, 1.0);
+  return out;
+}
+
+// 0 outside the bands, easing smoothly to 1 at the window edge.
+float edge_blur_strength(float y, constant EdgeBlurParams &p) {
+  float s = 0.0;
+  if (p.top_px > 0.0 && y < p.top_px) {
+    float t = 1.0 - y / p.top_px;
+    s = max(s, t * t * (3.0 - 2.0 * t));
+  }
+  float by = p.viewport.y - p.bottom_px;
+  if (p.bottom_px > 0.0 && y > by) {
+    float solid_y = p.viewport.y - p.bottom_solid_px;
+    if (y >= solid_y) {
+      s = 1.0;
+    } else {
+      float t = (y - by) / max(solid_y - by, 1.0);
+      s = max(s, t * t * (3.0 - 2.0 * t));
+    }
+  }
+  return s;
+}
+
+constant int EDGE_BLUR_TAPS = 8;
+
+// Horizontal Gaussian with a per-row radius.
+fragment float4 edge_blur_horizontal_fragment(
+    EdgeBlurVertexOut in [[stage_in]], constant EdgeBlurParams &p [[buffer(0)]],
+    texture2d<float> src [[texture(0)]]) {
+  constexpr sampler smp(coord::pixel, filter::linear, address::clamp_to_edge);
+  float2 pos = in.position.xy;
+  float r = edge_blur_strength(pos.y, p) * p.max_radius_px;
+  if (r < 0.5) {
+    return src.sample(smp, pos);
+  }
+  float step = r / float(EDGE_BLUR_TAPS);
+  float4 sum = float4(0.0);
+  float wsum = 0.0;
+  for (int i = -EDGE_BLUR_TAPS; i <= EDGE_BLUR_TAPS; i++) {
+    // step / sigma == 1/4 for sigma = r/2, so the weights are constant.
+    float w = exp(-float(i * i) / 32.0);
+    sum += src.sample(smp, pos + float2(float(i) * step, 0.0)) * w;
+    wsum += w;
+  }
+  return sum / wsum;
+}
+
+// Vertical Gaussian over the horizontally blurred rows, plus the background
+// tint. Pixels outside the bands are copied from the scene untouched.
+fragment float4 edge_blur_composite_fragment(
+    EdgeBlurVertexOut in [[stage_in]], constant EdgeBlurParams &p [[buffer(0)]],
+    texture2d<float> scene [[texture(0)]], texture2d<float> hblur [[texture(1)]]) {
+  constexpr sampler smp(coord::pixel, filter::linear, address::clamp_to_edge);
+  float2 pos = in.position.xy;
+  float s = edge_blur_strength(pos.y, p);
+  if (s <= 0.0) {
+    return scene.read(uint2(pos));
+  }
+  float r = s * p.max_radius_px;
+  float4 color;
+  if (r < 0.5) {
+    color = scene.read(uint2(pos));
+  } else {
+    float step = r / float(EDGE_BLUR_TAPS);
+    float4 sum = float4(0.0);
+    float wsum = 0.0;
+    for (int i = -EDGE_BLUR_TAPS; i <= EDGE_BLUR_TAPS; i++) {
+      float w = exp(-float(i * i) / 32.0);
+      sum += hblur.sample(smp, pos + float2(0.0, float(i) * step)) * w;
+      wsum += w;
+    }
+    color = sum / wsum;
+  }
+  float3 rgb = mix(color.rgb, p.tint.rgb, p.tint_max * s);
+  return float4(rgb, color.a);
+}
